# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# SQS Configuration
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/"account number"purchase-events-queue
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=30

# SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:"account number"purchase-decisions-topic

# API Configuration
API_PORT=8080
API_HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=purchase_decisions
DB_SSL_MODE=disable

# Application Configuration
APP_ENV=development
LOG_LEVEL=debug
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=5s

# Business Rules
MAX_PURCHASE_AMOUNT=10000.00
MIN_PURCHASE_AMOUNT=0.01
AUTO_APPROVE_THRESHOLD=500.00
AUTO_REJECT_THRESHOLD=9500.00
